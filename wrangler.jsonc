{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "navicore-legal",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "navicoreapp.com", "custom_domain": true }
  ]
}
